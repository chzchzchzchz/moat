#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// We use macros to compile different kernels from the same file.

#ifdef KERNEL_RMSNORM
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Input { float16_t x[]; };
layout(std430, binding = 1) readonly buffer Weight { float16_t w[]; };
layout(std430, binding = 2) writeonly buffer Output { float16_t out_buf[]; };
layout(push_constant) uniform Constants {
    uint dim;
    float eps;
} c;

shared float sum_sq_shared[256];

void main() {
    uint batch_idx = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    
    uint offset = batch_idx * c.dim;
    
    float local_sum = 0.0;
    for (uint i = tid; i < c.dim; i += gl_WorkGroupSize.x) {
        float val = float(x[offset + i]);
        local_sum += val * val;
    }
    sum_sq_shared[tid] = local_sum;
    barrier();
    
    for (uint s = gl_WorkGroupSize.x / 2; s > 0; s >>= 1) {
        if (tid < s) sum_sq_shared[tid] += sum_sq_shared[tid + s];
        barrier();
    }
    
    float mean_sq = sum_sq_shared[0] / float(c.dim);
    float rsqrt_val = inversesqrt(mean_sq + c.eps);
    
    for (uint i = tid; i < c.dim; i += gl_WorkGroupSize.x) {
        out_buf[offset + i] = float16_t(float(x[offset + i]) * rsqrt_val * float(w[i]));
    }
}
#endif

#ifdef KERNEL_ROPE
layout(local_size_x = 64) in;
